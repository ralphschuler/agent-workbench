# Copy to .env; credentials remain runtime-only and are never copied into the image.
AGENT_IMAGE=ghcr.io/ralphschuler/agent-workbench:latest
DESKTOP_PORT=6080
HINDSIGHT_ENABLED=0
HINDSIGHT_HOOKS_ENABLED=0
HINDSIGHT_BANK_ID=agent
HINDSIGHT_API_URL=http://hindsight:8888
# Uses a separate Codex ChatGPT login: python3 scripts/hindsight-login.py
HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=gpt-5.4-mini
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
# Only needed if deliberately switching to an API-key provider.
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_HOOK_TIMEOUT_SECONDS=5
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8
JEV_IMAGE_ROOTS=/workspace:/tmp
# Empty values use the persistent home profile and /workspace/.browser-artifacts.
PLAYWRIGHT_MCP_USER_DATA_DIR=
PLAYWRIGHT_MCP_OUTPUT_DIR=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: GitHub MCP also reuses `gh auth login` from the persistent home.
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=context,repos,issues,pull_requests,users,actions
# Opt in only if your host cannot run Chrome's sandbox; prefer host sandbox support.
CHROME_DISABLE_SANDBOX=0
