# Copy to .env; credentials remain runtime-only and are never copied into the image.
AGENT_IMAGE=ghcr.io/ralphschuler/agent:latest
DESKTOP_PORT=6080
HINDSIGHT_ENABLED=0
HINDSIGHT_HOOKS_ENABLED=0
HINDSIGHT_BANK_ID=agent
HINDSIGHT_API_URL=http://hindsight:8888
# Choose an actual model supported by your Hindsight provider before starting --profile memory.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4.1-mini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_HOOK_TIMEOUT_SECONDS=5
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opt in only if your host cannot run Chrome's sandbox; prefer host sandbox support.
CHROME_DISABLE_SANDBOX=0
